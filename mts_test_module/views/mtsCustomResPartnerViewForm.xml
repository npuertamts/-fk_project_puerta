<odoo>
    <record id="mts_custom_res_partner_view_form" model="ir.ui.view">
        <field name="name">mts.custom.res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="inside">
                <xpath expr="//field[@name='phone']" position="move"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Datos del contacto">
                    <field name="name"/>
                </page>
            </xpath>

            <xpath expr="//div[@class='mb8']" position="after">
                <group invisible="not is_company">
                    <field name="commercial_company_name"/>
                    <field name="company_date"/>
                    <field name="x_company_facturation" widget="monetary" invisible="customer_rank <= 0"/>
                </group> 
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Horarios" invisible="customer_rank <= 0">
                    <field name="horario_ids">
                        <list edit="True" delete="True" editable="bottom">
                            <field name="day"/>
                            <field name="from_hour" widget="float_time"/>
                            <field name="to_hour" widget="float_time"/>
                        </list>
                    </field>
                </page> 
            </xpath>
        </field>
    </record>    
</odoo>
